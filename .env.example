# Contas do Portal Minhas Importações (idCorreios)
# Formato: CPF:SENHA separados por vírgula (ou só o CPF, usando CORREIOS_PASS)
CORREIOS_ACCOUNTS=00000000000:sua_senha,11111111111

# Senha padrão caso apenas o CPF seja informado
CORREIOS_PASS=

# Encomendas antigas/estagnadas a ignorar no monitoramento ativo (separadas por vírgula)
IGNORED_PACKAGES=

# Janela máxima de idade (em dias) para considerar uma encomenda como ativa/recente
ACTIVE_MAX_AGE_DAYS=60

# Intervalo de verificação em minutos
CHECK_INTERVAL_MINUTES=30

# Token do bot do Telegram (crie um com o @BotFather)
TELEGRAM_BOT_TOKEN=

# URL alvo do portal
PORTAL_URL=https://portalimportador.correios.com.br/pages/pesquisarRemessaImportador/pesquisarRemessaImportador.jsf
